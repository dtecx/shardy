{
  "manifest_version": 3,
  "name": "Shardy",
  "version": "0.5.0",
  "description": "Collects MangaLib card shards by reading chapters that currently pay, at a human pace, within the site limits.",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "https://mangalib.me/*",
    "https://api.imglib.info/*",
    "https://cover.imglib.info/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mangalib.me/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shardy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
